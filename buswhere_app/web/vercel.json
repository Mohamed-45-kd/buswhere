{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(index.html|sw.js|flutter_bootstrap.js|manifest.json|version.json)?",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(self), screen-wake-lock=(self), camera=(), microphone=()" }
      ]
    }
  ]
}
